# ============================================================================
# AI YouTube Factory — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ============================================================================

# -- Core ---------------------------------------------------------------------
ENVIRONMENT=local                 # local | development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true

# -- Backend / API ------------------------------------------------------------
APP_NAME=AI YouTube Factory API
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SECRET_KEY=change-me-in-production

# -- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_youtube_factory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_youtube_factory

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- RabbitMQ -----------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -- Frontend / Admin (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# -- External providers (placeholders — wired up in later phases) ------------
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
