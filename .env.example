# ============================================================================
# AI YouTube Factory — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ============================================================================

# -- Core ---------------------------------------------------------------------
ENVIRONMENT=local                 # local | development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true

# -- Backend / API ------------------------------------------------------------
APP_NAME=AI YouTube Factory API
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# ENVIRONMENT=production refuses to start while SECRET_KEY or JWT_SECRET_KEY is
# a placeholder or under 32 characters. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000

# -- Authentication / JWT -----------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2
INVITATION_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_ENABLED=true

# -- Video pipeline (mock providers need no credentials) ----------------------
PIPELINE_SPEECH_PROVIDER=mock
PIPELINE_RENDER_PROVIDER=mock
PIPELINE_PUBLISH_PROVIDER=mock
PIPELINE_ANALYTICS_PROVIDER=mock
PIPELINE_DEFAULT_VOICE=default

# -- Storage ------------------------------------------------------------------
# local | s3 | minio | r2 | gcs | azure. Cloud backends need their extra:
#   pip install -e ".[s3]"  /  ".[gcs]"  /  ".[azure]"  /  ".[storage]"
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files

# S3-compatible (AWS S3, MinIO, Cloudflare R2)
STORAGE_BUCKET=ai-youtube-factory
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=            # http://localhost:9000 for the compose MinIO; blank for AWS
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=true
STORAGE_FORCE_PATH_STYLE=false   # MinIO requires true; AWS and R2 use false

# Google Cloud Storage
STORAGE_GCS_PROJECT=
STORAGE_GCS_CREDENTIALS_PATH=

# Azure Blob Storage
STORAGE_AZURE_ACCOUNT_URL=
STORAGE_AZURE_CONTAINER=ai-youtube-factory
STORAGE_AZURE_CONNECTION_STRING=

# -- Email (SMTP; disabled logs emails to stdout in dev) ----------------------
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@ai-youtube-factory.local
EMAIL_FROM_NAME=AI YouTube Factory

# -- OAuth: GitHub ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# -- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_youtube_factory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_youtube_factory

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- RabbitMQ -----------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -- Frontend / Admin (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# -- Docker host port overrides (change if a port is already in use) ---------
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMIN_PORT=3001

# -- LLM framework (Claude) ---------------------------------------------------
# The provider abstraction resolves models via config — never hardcoded.
# Leave ANTHROPIC_API_KEY empty to fall back to the deterministic mock provider.
LLM_DEFAULT_PROVIDER=anthropic    # anthropic | mock
LLM_DEFAULT_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_THINKING=adaptive             # adaptive | off
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_STREAMING_DEFAULT=true
LLM_SYSTEM_PROMPT=
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_CONCURRENT=10
LLM_FALLBACK_MODEL=

# -- External providers (placeholders — wired up in later phases) ------------
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
