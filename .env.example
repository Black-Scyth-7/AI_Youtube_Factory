# ============================================================================
# AI YouTube Factory — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ============================================================================

# -- Core ---------------------------------------------------------------------
ENVIRONMENT=local                 # local | development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true

# -- Backend / API ------------------------------------------------------------
APP_NAME=AI YouTube Factory API
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000

# -- Authentication / JWT -----------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2
INVITATION_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_ENABLED=true

# -- Email (SMTP; disabled logs emails to stdout in dev) ----------------------
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@ai-youtube-factory.local
EMAIL_FROM_NAME=AI YouTube Factory

# -- OAuth: GitHub ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# -- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_youtube_factory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_youtube_factory

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- RabbitMQ -----------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -- Frontend / Admin (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# -- External providers (placeholders — wired up in later phases) ------------
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
