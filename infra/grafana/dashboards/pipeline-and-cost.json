{
  "uid": "ayf-pipeline-cost",
  "title": "Pipeline and cost",
  "description": "Video pipeline throughput, workflow execution, and LLM spend.",
  "tags": ["ai-youtube-factory", "pipeline", "cost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM spend (last 24h)",
      "description": "increase() over the window, so a process restart does not reset it.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_cost_usd_total[24h]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens (last 24h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_tokens_total[24h]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workflows in flight",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(workflow_runs_in_progress)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pipeline failure rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_stages_total{outcome=\"failed\"}[1h])) / clamp_min(sum(rate(pipeline_stages_total[1h])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline stages by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{stage}} ({{outcome}})",
          "expr": "sum by (stage, outcome) (rate(pipeline_stages_total[15m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stage duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{stage}}",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(pipeline_stage_duration_seconds_bucket[1h])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM spend rate by model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{model}}",
          "expr": "sum by (model) (rate(llm_cost_usd_total[1h])) * 3600"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM latency (p95) and cache hits",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95 {{model}}",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_request_duration_seconds_bucket[15m])))"
        },
        {
          "refId": "B",
          "legendFormat": "cache hit ratio",
          "expr": "sum(rate(llm_requests_total{outcome=\"cache_hit\"}[15m])) / clamp_min(sum(rate(llm_requests_total[15m])), 1e-9)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Workflow nodes by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{node_type}} ({{outcome}})",
          "expr": "sum by (node_type, outcome) (rate(workflow_nodes_total[15m]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Artifact size (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{stage}}",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(pipeline_artifact_bytes_bucket[6h])))"
        }
      ]
    }
  ]
}
